# Configurações do Ozzy - Empório da Música
# Chave de API do Groq (obtenha em https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Modelo LLM utilizado no Groq
GROQ_MODEL=llama-3.3-70b-versatile

# Caminho do banco relacional SQLite
DB_PATH=data/emporio.db

# Caminho do banco vetorial ChromaDB
CHROMA_PATH=data/chroma

# Modelo de embeddings (HuggingFace / Sentence-Transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Configuração do servidor FastAPI
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
